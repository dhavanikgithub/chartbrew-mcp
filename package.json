{
  "name": "chartbrew-mcp",
  "version": "0.1.0",
  "description": "Let your AI agent run Chartbrew — manage teams, connections, datasets, dashboards & charts, run live queries, and embed securely, all through natural language via the Model Context Protocol.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chartbrew-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "chartbrew",
    "model-context-protocol",
    "ai",
    "llm",
    "claude",
    "analytics",
    "dashboards"
  ],
  "author": "dhavanikgithub",
  "license": "MIT",
  "homepage": "https://github.com/dhavanikgithub/chartbrew-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhavanikgithub/chartbrew-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dhavanikgithub/chartbrew-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env-template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
